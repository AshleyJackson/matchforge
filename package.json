{
  "name": "matchforge",
  "version": "0.0.3",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --outDir dist && tsc --declaration --emitDeclarationOnly --noEmit false --allowImportingTsExtensions false --outDir dist",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  }
}
