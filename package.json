{
  "name": "matchforge",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --outDir dist && tsc --declaration --emitDeclarationOnly --noEmit false --allowImportingTsExtensions false --outDir dist",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.2",
    "@upstash/redis": "^1.38.4",
    "eslint": "^9.39.2",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
